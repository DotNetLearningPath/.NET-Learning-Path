            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
                  "const countries = pm.response.json();",
                  "pm.test('Countries are not empty', function () { pm.expect(countries).to.have.length.greaterThan(0); });",
                  "if (countries.length > 0) pm.collectionVariables.set('countryId', countries[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/brokers/countries"
          }
