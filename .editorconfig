root = true


# ============================================================
# GLOBAL C# RULES
# ============================================================

[*.cs]


# ============================================================
# 1. FORMATTING
# ============================================================

indent_style = space
indent_size = 4

end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Opening braces on new line
csharp_new_line_before_open_brace = all

# Do not keep multiple statements / blocks compressed on one line
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false


# ============================================================
# 2. BRACES ARE REQUIRED
# Guideline: always use braces for if/else/for/while/etc.
# ============================================================

csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error


# ============================================================
# 3. USING DIRECTIVES BEFORE NAMESPACE
# ============================================================

csharp_using_directive_placement = outside_namespace:error
dotnet_diagnostic.IDE0065.severity = error


# ============================================================
# 4. TYPES -> PascalCase
# Classes, structs, interfaces, enums, delegates
# ============================================================

dotnet_naming_rule.types_should_be_pascal_case.severity = error
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate

dotnet_naming_style.pascal_case.capitalization = pascal_case


# ============================================================
# 5. METHODS / PROPERTIES / EVENTS -> PascalCase
# ============================================================

dotnet_naming_rule.members_should_be_pascal_case.severity = error
dotnet_naming_rule.members_should_be_pascal_case.symbols = members
dotnet_naming_rule.members_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.members.applicable_kinds = method, property, event
dotnet_naming_symbols.members.applicable_accessibilities = public, internal, protected, protected_internal


# ============================================================
# 6. PRIVATE FIELDS -> _camelCase
# ============================================================

dotnet_naming_rule.private_fields_should_be_underscore_camel_case.severity = error
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case


# ============================================================
# 7. PARAMETERS -> camelCase
# ============================================================

dotnet_naming_rule.parameters_should_be_camel_case.severity = error
dotnet_naming_rule.parameters_should_be_camel_case.symbols = parameters
dotnet_naming_rule.parameters_should_be_camel_case.style = camel_case

dotnet_naming_symbols.parameters.applicable_kinds = parameter


# ============================================================
# 8. LOCAL VARIABLES -> camelCase
# ============================================================

dotnet_naming_rule.locals_should_be_camel_case.severity = error
dotnet_naming_rule.locals_should_be_camel_case.symbols = locals
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case

dotnet_naming_symbols.locals.applicable_kinds = local

dotnet_naming_style.camel_case.capitalization = camel_case


# ============================================================
# 9. VAR
#
# We intentionally DON'T enforce var vs explicit type.
# Guideline says var is acceptable when the type is obvious,
# which cannot be represented reliably as a hard rule.
# ============================================================

dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = none


# ============================================================
# 10. UNUSED CODE
# ============================================================

# Unnecessary assignment
dotnet_diagnostic.IDE0059.severity = warning

# Unused parameter
dotnet_diagnostic.IDE0060.severity = warning


# ============================================================
# 11. PARAMETER VALIDATION
#
# CA1062 checks public methods for argument validation.
# It cannot guarantee that validation is literally the first
# statement, but it helps enforce the guideline.
# ============================================================

dotnet_diagnostic.CA1062.severity = warning


# ============================================================
# 12. EXCEPTION HANDLING
#
# Avoid broad catch(Exception) when possible.
# Does not completely detect all "empty catch" cases.
# ============================================================

dotnet_diagnostic.CA1031.severity = warning


# ============================================================
# 13. NULLABLE SAFETY
#
# NOTE:
# Nullable must ALSO be enabled in the .csproj:
#
# <Nullable>enable</Nullable>
# ============================================================

# Converting null literal / possible null to non-nullable
dotnet_diagnostic.CS8600.severity = warning

# Possible null assignment
dotnet_diagnostic.CS8601.severity = warning

# Possible null dereference
dotnet_diagnostic.CS8602.severity = error

# Possible null return
dotnet_diagnostic.CS8603.severity = warning

# Possible null argument
dotnet_diagnostic.CS8604.severity = warning

# Non-nullable field not initialized
dotnet_diagnostic.CS8618.severity = warning

# Nullability mismatch
dotnet_diagnostic.CS8625.severity = warning


# ============================================================
# 14. COMPLEXITY / VERY COMPLEX METHODS
#
# Approximation of:
# - methods should stay small
# - avoid excessive nested logic
#
# This is NOT equivalent to SRP.
# ============================================================

dotnet_diagnostic.CA1502.severity = warning


# ============================================================
# 15. ASYNC RULES
#
# These two rules require:
# Microsoft.VisualStudio.Threading.Analyzers
#
# Uncomment ONLY after adding that analyzer package.
# ============================================================

# Avoid async void except event handlers
# dotnet_diagnostic.VSTHRD100.severity = error

# Async methods should normally end in Async
# dotnet_diagnostic.VSTHRD200.severity = warning


# ============================================================
# 16. DISABLE NOISY RULES THAT ARE NOT IN OUR GUIDELINES
# ============================================================

# Do not force top-level statements
dotnet_diagnostic.IDE0210.severity = none

# Do not force primary constructors
dotnet_diagnostic.IDE0290.severity = none

# Do not force block-scoped namespace conversion
dotnet_diagnostic.IDE0160.severity = none

# Do not force readonly structs/members
dotnet_diagnostic.IDE0250.severity = none
dotnet_diagnostic.IDE0251.severity = none

# Do not force collection initializer simplifications
dotnet_diagnostic.IDE0028.severity = none

# Do not force name simplification
dotnet_diagnostic.IDE0001.severity = none

# Do not force if simplification
dotnet_diagnostic.IDE0046.severity = none