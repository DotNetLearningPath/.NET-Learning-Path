{
  "ConnectionStrings": {
    "InsuranceAppDBConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Insurances;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },

  "LoggingSettings": {
    "LogFolder": "applogs",
    "LogFileNameInfo": "info-.log",
    "LogFileNameError": "error-.log"
  },

  "AllowedHosts": "*"

}
